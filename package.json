{
  "name": "dsh-mx-rate-limit",
  "version": "0.1.0",
  "description": "Token-bucket request rate limiting for DeepSeek Harness model calls: queues a request before its provider call instead of reacting to a 429.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:e2e": "node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.0"
  }
}