# Dependencies
node_modules/

# Build output.
#
# `lib/` is generated by `npm run build` and is deliberately NOT committed: the
# `prepare` script runs it automatically when the package is installed from a
# Git URL, so the repository stays free of generated code. Two consequences
# worth knowing:
#
#   - A LOCAL-DIRECTORY install is symlinked by pnpm and never runs `prepare`,
#     so run `npm run build` once before installing by path.
#   - pnpm 11 blocks dependency build scripts until they are approved. If the
#     Harness asks which packages may run install scripts, allow this one —
#     otherwise `lib/` is missing and the plugin cannot be loaded.
lib/

# TypeScript incremental state
*.tsbuildinfo

# Packaged tarballs (`npm pack` output)
*.tgz

# Test and tool output
coverage/
.nyc_output/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Harness end-to-end scratch
.dsh-home/
e2e.out
sessions/

# Editor and OS noise
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local environment overrides
.env
.env.local
*.local